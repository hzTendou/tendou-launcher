+float ggml_fp8_e4m3_to_fp32(ggml_fp8_e4m3_t x) {
+    const uint32_t sign = ((uint32_t) (x & 0x80u)) << 24;
+    const uint32_t ax   = (uint32_t) (x & 0x7Fu);
+    uint32_t bits;
+
+    if (ax == 0x7Fu) {
+        bits = sign | 0x7FC00000u; // NaN
+    } else if (ax == 0u) {
+        bits = sign; // +/-0.0
+    } else {
+        uint32_t exp = ax >> 3;
+        uint32_t man = ax & 0x7u;
+        if (exp == 0u) {
+            uint32_t fp32_exp = 121u; // 2^-6
+            while ((man & 0x8u) == 0u) {
+                man <<= 1;
+                fp32_exp--;
+            }
+            man &= 0x7u;
+            bits = sign | (fp32_exp << 23) | (man << 20);
+        } else {
+            uint32_t fp32_exp = exp + 120u; // exp - 7 + 127
+            bits = sign | (fp32_exp << 23) | (man << 20);
+        }
+    }
+
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+ggml_fp8_e4m3_t ggml_fp32_to_fp8_e4m3(float x) {
+    uint32_t bits;
+    memcpy(&bits, &x, sizeof(bits));
+
+    const uint8_t  sign = (uint8_t) ((bits >> 24) & 0x80u);
+    const uint32_t absx = bits & 0x7FFFFFFFu;
+
+    if (absx > 0x7F800000u) {
+        return (ggml_fp8_e4m3_t) (sign | 0x7Fu); // NaN
+    }
+    if (absx <= 0x3A800000u) {
+        return (ggml_fp8_e4m3_t) sign; // <= 2^-10 rounds to +/-0.0 (even)
+    }
+    if (absx >= 0x43E00000u) {
+        return (ggml_fp8_e4m3_t) (sign | 0x7Eu); // saturate >= 448.0 (incl. +Inf) to +/-448.0
+    }
+    if (absx >= 0x3C800000u) {
+        const uint32_t fp8_exp   = ((absx >> 23) & 0xFFu) - 120u;
+        const uint32_t fp8_man   = (absx >> 20) & 0x7u;
+        const uint32_t round_rem = absx & 0xFFFFFu;
+        uint32_t res = (fp8_exp << 3) | fp8_man;
+        if (round_rem > 0x80000u || (round_rem == 0x80000u && (fp8_man & 1u))) {
+            res += 1u;
+        }
+        return (ggml_fp8_e4m3_t) (sign | (uint8_t) res);
+    }
+
+    const uint32_t fp32_exp  = (absx >> 23) & 0xFFu;
+    const uint32_t shift     = 121u - fp32_exp;
+    const uint32_t sig       = (absx & 0x7FFFFFu) | 0x800000u;
+    const uint32_t man_shift = 20u + shift;
+    uint32_t       res       = sig >> man_shift;
+    const uint32_t half_ulp  = 1u << (man_shift - 1u);
+    const uint32_t round_rem = sig & ((1u << man_shift) - 1u);
+    if (round_rem > half_ulp || (round_rem == half_ulp && (res & 1u))) {
+        res += 1u;
+    }
+    return (ggml_fp8_e4m3_t) (sign | (uint8_t) res);
+}
+
+void ggml_fp8_e4m3_to_fp32_row(const ggml_fp8_e4m3_t * x, float * y, int64_t n) {
+    for (int64_t i = 0; i < n; ++i) {
+        y[i] = ggml_fp8_e4m3_to_fp32(x[i]);
+    }
+}
+
+void ggml_fp32_to_fp8_e4m3_row(const float * x, ggml_fp8_e4m3_t * y, int64_t n) {
+    for (int64_t i = 0; i < n; ++i) {
+        y[i] = ggml_fp32_to_fp8_e4m3(x[i]);
