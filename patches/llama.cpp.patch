+static void ggml_backend_sched_init_moe_pinned(
+        ggml_backend_sched_t sched,
+        ggml_backend_t       split_backend,
+        size_t               default_mb,
+        size_t               fallback_mb,
+        bool                 cap_to_default) {
+    if (sched->moe_pinned_buffer) {
+        return;
+    }
+
+    const char * env_pinned = std::getenv("ATLAS_MOE_PINNED_MB");
+    size_t primary_mb = default_mb;
+    size_t secondary_mb = fallback_mb;
+    if (env_pinned != nullptr) {
+        const long env_mb = std::atol(env_pinned);
+        if (env_mb <= 0) {
+            return;
+        }
+        primary_mb = cap_to_default ? std::min<size_t>((size_t) env_mb, default_mb) : (size_t) env_mb;
+        secondary_mb = (primary_mb > fallback_mb && fallback_mb > 0) ? fallback_mb : 0;
+    }
+
+    ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(split_backend->device);
+    if (!host_buft) {
+        return;
+    }
+
+    size_t target_size = primary_mb * 1024 * 1024;
+    sched->moe_pinned_buffer = ggml_backend_buft_alloc_buffer(host_buft, target_size);
+    if (!sched->moe_pinned_buffer && secondary_mb > 0 && secondary_mb < primary_mb) {
+        target_size = secondary_mb * 1024 * 1024;
+        sched->moe_pinned_buffer = ggml_backend_buft_alloc_buffer(host_buft, target_size);
+    }
+    if (sched->moe_pinned_buffer) {
+        sched->moe_pinned_base   = (uint8_t *) ggml_backend_buffer_get_base(sched->moe_pinned_buffer);
+        sched->moe_pinned_size   = target_size;
+        sched->moe_pinned_offset = 0;
+    }
+}
