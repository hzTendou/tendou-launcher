+static ggml_tensor * concat_tokens_tree(ggml_context * ctx0, std::vector<ggml_tensor *> & chunks) {
+    GGML_ASSERT(!chunks.empty());
+    while (chunks.size() > 1) {
+        std::vector<ggml_tensor *> next;
+        next.reserve((chunks.size() + 1) / 2);
+        for (size_t i = 0; i + 1 < chunks.size(); i += 2) {
+            next.push_back(ggml_concat(ctx0, chunks[i], chunks[i + 1], 1));
+        }
+        if (chunks.size() % 2 == 1) {
+            next.push_back(chunks.back());
+        }
+        chunks.swap(next);
+    }
+    return chunks[0];
+}
