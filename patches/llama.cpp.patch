--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -644,6 +644,41 @@ bool ggml_backend_dev_supports_buft(ggml_backend_dev_t device, ggml_backend_buff
 bool ggml_backend_dev_offload_op(ggml_backend_dev_t device, const struct ggml_tensor * op) {
     GGML_ASSERT(device);
     if (device->iface.offload_op != NULL) {
+        // Never auto-offload GGML_OP_MUL_MAT_ID when the 3D expert weight tensor (src[0])
+        // resides in host memory (CPU / CPU_Mapped): offloading copies all N_experts
+        // over PCIe into a massive VRAM staging buffer instead of running only the K active
+        // experts on the AVX-512 VNNI CPU MoE co-processor.
+        if (op->op == GGML_OP_MUL_MAT_ID) {
+            if (op->src[0] && op->src[0]->buffer && ggml_backend_buffer_is_host(op->src[0]->buffer)) {
+                return false;
+            }
+        }
+        // Issue #31229 fix: 3D/4D head-wise norms (e.g. [head_dim, n_heads, n_tokens, 1])
+        // and 1D weight mul/add ops have effective token batch size ne[2]*ne[3], not ne[1]*ne[2]*ne[3].
+        switch (op->op) {
+            case GGML_OP_NORM:
+            case GGML_OP_RMS_NORM:
+            case GGML_OP_L2_NORM:
+                if (op->ne[2] > 1 || op->ne[3] > 1 ||
+                    (op->src[0] && (op->src[0]->ne[2] > 1 || op->src[0]->ne[3] > 1)) ||
+                    (op->ne[0] <= 512 && op->ne[1] >= 8)) {
+                    if (op->ne[2] * op->ne[3] < 32) {
+                        return false;
+                    }
+                }
+                break;
+            case GGML_OP_MUL:
+            case GGML_OP_ADD:
+                if (op->src[1] && op->src[1]->ne[1] == 1 && op->src[1]->ne[2] == 1 && op->src[1]->ne[3] == 1 &&
+                    (op->ne[2] > 1 || op->ne[3] > 1 || (op->ne[0] <= 512 && op->ne[1] >= 8))) {
+                    if (op->ne[2] * op->ne[3] < 32) {
+                        return false;
+                    }
+                }
+                break;
+            default:
+                break;
+        }
         return device->iface.offload_op(device, op);
     }
 
