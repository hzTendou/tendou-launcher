+                const int16_t ls1 = ((x3[ibl].scales_l[ib/2] & 0xf) | ((sh3 << 4) & 0x30)) - 32;
+                const int16_t ls2 = ((x3[ibl].scales_l[ib/2] >>  4) | ((sh3 << 2) & 0x30)) - 32;
+                sh3 >>= 4;
+                const __m256i p_1 = _mm256_madd_epi16(p16_1, _mm256_set1_epi16(ls1));
+                const __m256i p_2 = _mm256_madd_epi16(p16_2, _mm256_set1_epi16(ls2));
+                sumi3 = _mm256_add_epi32(sumi3, _mm256_add_epi32(p_1, p_2));
+            }
+        }
+
+        const float yd = y[ibl].d;
+        accum0 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x0[ibl].d) * yd), _mm256_cvtepi32_ps(sumi0), accum0);
+        accum1 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x1[ibl].d) * yd), _mm256_cvtepi32_ps(sumi1), accum1);
+        accum2 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x2[ibl].d) * yd), _mm256_cvtepi32_ps(sumi2), accum2);
+        accum3 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x3[ibl].d) * yd), _mm256_cvtepi32_ps(sumi3), accum3);
+    }
+
+    float * GGML_RESTRICT s0 = (float *)((char *)s + 0 * bs);
+    float * GGML_RESTRICT s1 = (float *)((char *)s + 1 * bs);
+    float * GGML_RESTRICT s2 = (float *)((char *)s + 2 * bs);
+    float * GGML_RESTRICT s3 = (float *)((char *)s + 3 * bs);
+
+    *s0 = hsum_float_8(accum0);
+    *s1 = hsum_float_8(accum1);
+    *s2 = hsum_float_8(accum2);
+    *s3 = hsum_float_8(accum3);
+#else
+    UNUSED(x0); UNUSED(x1); UNUSED(x2); UNUSED(x3);
+    UNUSED(y); UNUSED(nb);
+    for (int r = 0; r < 4; ++r) {
+        ggml_vec_dot_iq4_xs_q8_K_generic(n, (float *)((char *)s + (size_t)r * bs), 0, (const char *)vx + (size_t)r * bx, 0, vy, 0, 1);
+    }
+#endif
+}
+
+void ggml_vec_dot_iq3_s_q8_K_x4(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QK_K == 0);
+    assert(nrc == 4);
+    UNUSED(by);
+    UNUSED(nrc);
+
+    if (bs == 0) {
+        bs = sizeof(float);
+    }
+
+#if defined(__AVX2__)
+    const block_iq3_s * GGML_RESTRICT x0 = (const block_iq3_s *)((const char *)vx + 0 * bx);
+    const block_iq3_s * GGML_RESTRICT x1 = (const block_iq3_s *)((const char *)vx + 1 * bx);
+    const block_iq3_s * GGML_RESTRICT x2 = (const block_iq3_s *)((const char *)vx + 2 * bx);
+    const block_iq3_s * GGML_RESTRICT x3 = (const block_iq3_s *)((const char *)vx + 3 * bx);
+
+    const block_q8_K * GGML_RESTRICT y = (const block_q8_K *)vy;
+    const int nb = n / QK_K;
+
+    static const uint8_t k_mask1[32] = {
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+        0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03
+    };
+    static const uint8_t k_mask2[32] = {
+        0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
+        0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80
+    };
+
+    const __m256i mask1     = _mm256_loadu_si256((const __m256i *)k_mask1);
+    const __m256i mask2     = _mm256_loadu_si256((const __m256i *)k_mask2);
+    const __m256i idx_shift = _mm256_set_epi32(1, 2, 3, 4, 5, 6, 7, 8);
+    const __m256i idx_mask  = _mm256_set1_epi32(256);
+
+    typedef union {
+        __m256i  vec[2];
+        uint32_t index[16];
+    } iq3s_index_t;
+
+    iq3s_index_t idx;
+
+    __m256 accum0 = _mm256_setzero_ps();
+    __m256 accum1 = _mm256_setzero_ps();
+    __m256 accum2 = _mm256_setzero_ps();
+    __m256 accum3 = _mm256_setzero_ps();
+
+#define ATLAS_IQ3S_X4_STEP(XR, QSR, QHR, SIGNR, SUM1R, SUM2R)                                                        \
+    do {                                                                                                             \
+        const __m256i idx_l = _mm256_cvtepu8_epi16(_mm_loadu_si128((const __m128i *)(QSR)));                         \
+        (QSR) += 16;                                                                                                 \
+        idx.vec[0] = _mm256_set1_epi32((QHR)[ib32 + 0]);                                                             \
+        idx.vec[1] = _mm256_set1_epi32((QHR)[ib32 + 1]);                                                             \
+        idx.vec[0] = _mm256_and_si256(_mm256_sllv_epi32(idx.vec[0], idx_shift), idx_mask);                           \
+        idx.vec[1] = _mm256_and_si256(_mm256_sllv_epi32(idx.vec[1], idx_shift), idx_mask);                           \
+        idx.vec[0] = _mm256_or_si256(idx.vec[0], _mm256_cvtepi16_epi32(_mm256_castsi256_si128(idx_l)));              \
+        idx.vec[1] = _mm256_or_si256(idx.vec[1], _mm256_cvtepi16_epi32(_mm256_extractf128_si256(idx_l, 1)));         \
+        const __m256i q2_1 = _mm256_set_epi32(                                                                       \
+            (int)iq3s_grid[idx.index[7]],  (int)iq3s_grid[idx.index[6]],                                             \
+            (int)iq3s_grid[idx.index[5]],  (int)iq3s_grid[idx.index[4]],                                             \
+            (int)iq3s_grid[idx.index[3]],  (int)iq3s_grid[idx.index[2]],                                             \
+            (int)iq3s_grid[idx.index[1]],  (int)iq3s_grid[idx.index[0]]);                                            \
+        const __m256i q2_2 = _mm256_set_epi32(                                                                       \
+            (int)iq3s_grid[idx.index[15]], (int)iq3s_grid[idx.index[14]],                                            \
+            (int)iq3s_grid[idx.index[13]], (int)iq3s_grid[idx.index[12]],                                            \
+            (int)iq3s_grid[idx.index[11]], (int)iq3s_grid[idx.index[10]],                                            \
+            (int)iq3s_grid[idx.index[9]],  (int)iq3s_grid[idx.index[8]]);                                            \
+        __m256i aux256 = _mm256_set1_epi32((int)((uint32_t)(SIGNR)[0] | ((uint32_t)(SIGNR)[1] << 16)));              \
+        aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256, mask1), mask2);                                        \
+        const __m256i s2_1  = _mm256_cmpeq_epi8(aux256, mask2);                                                      \
+        const __m256i q8s_1 = _mm256_sub_epi8(_mm256_xor_si256(s2_1, q8_1), s2_1);                                   \
+        aux256 = _mm256_set1_epi32((int)((uint32_t)(SIGNR)[2] | ((uint32_t)(SIGNR)[3] << 16)));                      \
+        aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256, mask1), mask2);                                        \
+        const __m256i s2_2  = _mm256_cmpeq_epi8(aux256, mask2);                                                      \
+        const __m256i q8s_2 = _mm256_sub_epi8(_mm256_xor_si256(s2_2, q8_2), s2_2);                                   \
+        (SIGNR) += 4;                                                                                                \
+        const __m256i dot1 = _mm256_maddubs_epi16(q2_1, q8s_1);                                                      \
+        const __m256i dot2 = _mm256_maddubs_epi16(q2_2, q8s_2);                                                      \
+        const uint16_t ls1 = (uint16_t)((XR)[i].scales[ib32 / 2] & 0xf);                                             \
+        const uint16_t ls2 = (uint16_t)((XR)[i].scales[ib32 / 2] >> 4);                                              \
+        const __m256i p1   = _mm256_madd_epi16(dot1, _mm256_set1_epi16((int16_t)(2 * ls1 + 1)));                     \
+        const __m256i p2   = _mm256_madd_epi16(dot2, _mm256_set1_epi16((int16_t)(2 * ls2 + 1)));                     \
+        (SUM1R) = _mm256_add_epi32((SUM1R), p1);                                                                     \
+        (SUM2R) = _mm256_add_epi32((SUM2R), p2);                                                                     \
+    } while (0)
+
+    for (int i = 0; i < nb; ++i) {
+        const float yd = y[i].d;
+        const float d0 = GGML_CPU_FP16_TO_FP32(x0[i].d) * yd;
+        const float d1 = GGML_CPU_FP16_TO_FP32(x1[i].d) * yd;
+        const float d2 = GGML_CPU_FP16_TO_FP32(x2[i].d) * yd;
+        const float d3 = GGML_CPU_FP16_TO_FP32(x3[i].d) * yd;
+
+        const uint8_t  * GGML_RESTRICT qs0    = x0[i].qs;
+        const uint8_t  * GGML_RESTRICT qs1    = x1[i].qs;
+        const uint8_t  * GGML_RESTRICT qs2    = x2[i].qs;
+        const uint8_t  * GGML_RESTRICT qs3    = x3[i].qs;
+        const uint8_t  * GGML_RESTRICT qh0    = x0[i].qh;
+        const uint8_t  * GGML_RESTRICT qh1    = x1[i].qh;
+        const uint8_t  * GGML_RESTRICT qh2    = x2[i].qh;
+        const uint8_t  * GGML_RESTRICT qh3    = x3[i].qh;
+        const uint16_t * GGML_RESTRICT signs0 = (const uint16_t *)x0[i].signs;
+        const uint16_t * GGML_RESTRICT signs1 = (const uint16_t *)x1[i].signs;
+        const uint16_t * GGML_RESTRICT signs2 = (const uint16_t *)x2[i].signs;
+        const uint16_t * GGML_RESTRICT signs3 = (const uint16_t *)x3[i].signs;
+        const int8_t   * GGML_RESTRICT q8     = y[i].qs;
+
+        __m256i sumi1_0 = _mm256_setzero_si256();
+        __m256i sumi2_0 = _mm256_setzero_si256();
+        __m256i sumi1_1 = _mm256_setzero_si256();
+        __m256i sumi2_1 = _mm256_setzero_si256();
+        __m256i sumi1_2 = _mm256_setzero_si256();
+        __m256i sumi2_2 = _mm256_setzero_si256();
+        __m256i sumi1_3 = _mm256_setzero_si256();
+        __m256i sumi2_3 = _mm256_setzero_si256();
+
+        for (int ib32 = 0; ib32 < QK_K / 32; ib32 += 2) {
+            const __m256i q8_1 = _mm256_loadu_si256((const __m256i *)q8); q8 += 32;
+            const __m256i q8_2 = _mm256_loadu_si256((const __m256i *)q8); q8 += 32;
+
+            ATLAS_IQ3S_X4_STEP(x0, qs0, qh0, signs0, sumi1_0, sumi2_0);
+            ATLAS_IQ3S_X4_STEP(x1, qs1, qh1, signs1, sumi1_1, sumi2_1);
+            ATLAS_IQ3S_X4_STEP(x2, qs2, qh2, signs2, sumi1_2, sumi2_2);
+            ATLAS_IQ3S_X4_STEP(x3, qs3, qh3, signs3, sumi1_3, sumi2_3);
+        }
+
+        accum0 = _mm256_fmadd_ps(_mm256_set1_ps(d0), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi1_0, sumi2_0)), accum0);
+        accum1 = _mm256_fmadd_ps(_mm256_set1_ps(d1), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi1_1, sumi2_1)), accum1);
+        accum2 = _mm256_fmadd_ps(_mm256_set1_ps(d2), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi1_2, sumi2_2)), accum2);
+        accum3 = _mm256_fmadd_ps(_mm256_set1_ps(d3), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi1_3, sumi2_3)), accum3);
+    }
+
+#undef ATLAS_IQ3S_X4_STEP
+
+    float * GGML_RESTRICT s0 = (float *)((char *)s + 0 * bs);
+    float * GGML_RESTRICT s1 = (float *)((char *)s + 1 * bs);
+    float * GGML_RESTRICT s2 = (float *)((char *)s + 2 * bs);
+    float * GGML_RESTRICT s3 = (float *)((char *)s + 3 * bs);
+
+    *s0 = hsum_float_8(accum0);
+    *s1 = hsum_float_8(accum1);
+    *s2 = hsum_float_8(accum2);
+    *s3 = hsum_float_8(accum3);
+#else
+    for (int r = 0; r < 4; ++r) {
+        ggml_vec_dot_iq3_s_q8_K(n, (float *)((char *)s + (size_t)r * bs), 0, (const char *)vx + (size_t)r * bx, 0, vy, 0, 1);
+    }
+#endif
+}
