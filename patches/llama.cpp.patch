+template <ggml_type type, int J, bool fallback>
+static void launch_mul_mat_q_few_row(ggml_backend_cuda_context & ctx, const mmq_few_row_args & args, cudaStream_t stream) {
+    GGML_UNUSED(ctx);
+    const int id        = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[id].cc;
+    const int warp_size = ggml_cuda_info().devices[id].warp_size;
+
+    const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc);
+    GGML_ASSERT(config.nthreads % warp_size == 0);
+    GGML_ASSERT(args.n_experts <= 65535);
+    GGML_ASSERT(args.stride_col_dst % args.stride_channel_dst == 0);
+    GGML_ASSERT(args.n_tokens < (1 << 16) && args.n_expert_used < (1 << 16));
+
+    const int nwarps        = config.nthreads / warp_size;
+    const int nbytes_shared = mmq_get_nbytes_shared(config, cc);
+
+    MMQ_SET_SHARED_MEMORY_LIMIT((mul_mat_q_few_row<type, J, fallback>), nbytes_shared);
+
+    const int nty = (args.nrows_x + config.I - 1) / config.I;
+    if (nty == 0 || args.n_experts == 0 || args.n_tokens == 0 || args.n_expert_used == 0) {
+        return;
+    }
+
+    const dim3 block_nums(nty, static_cast<unsigned int>(args.n_experts), 1);
+    const dim3 block_dims(warp_size, nwarps, 1);
+    const uint3 blocks_per_ne00_fd = init_fastdiv_values(args.ncols_x / ggml_cuda_type_traits<type>::qk);
+
+    mul_mat_q_few_row<type, J, fallback><<<block_nums, block_dims, nbytes_shared, stream>>>(
+        args.x, args.y, args.ids, args.dst,
+        blocks_per_ne00_fd, static_cast<int>(args.ncols_x), static_cast<int>(args.nrows_x),
+        static_cast<int>(args.stride_row_x), args.stride_channel_x_bytes,
+        static_cast<int>(args.nchannels_y), args.stride_channel_y, args.stride_col_y,
+        static_cast<int>(args.stride_channel_dst), static_cast<int>(args.stride_col_dst),
+        static_cast<int>(args.n_tokens), static_cast<int>(args.n_expert_used), static_cast<int>(args.ids_si1),
+        args.y_aligned_f4);
+}
+
+template <ggml_type type, bool fallback>
+static void mul_mat_q_few_row_switch_J(ggml_backend_cuda_context & ctx, const mmq_few_row_args & args, cudaStream_t stream) {
+    const int    id    = ggml_cuda_get_device();
+    const int    cc    = ggml_cuda_info().devices[id].cc;
+    const size_t smpbo = ggml_cuda_info().devices[id].smpbo;
+
+    int J_best = 0;
+    for (int J = 8; J <= 32; J += 8) {
+        const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc);
+        if (config.type == GGML_TYPE_COUNT) {
+            continue;
+        }
+        if (mmq_get_nbytes_shared(config, cc) + (J + 1) * sizeof(int) > smpbo) {
+            continue;
+        }
+        J_best = J;
+        if (J >= args.n_tokens) {
+            break;
+        }
+    }
+
+    switch (J_best) {
+        case  8:
+            launch_mul_mat_q_few_row<type,  8, fallback>(ctx, args, stream);
+            break;
+        case 16:
+            launch_mul_mat_q_few_row<type, 16, fallback>(ctx, args, stream);
+            break;
+        case 24:
+            launch_mul_mat_q_few_row<type, 24, fallback>(ctx, args, stream);
+            break;
+        case 32:
+            launch_mul_mat_q_few_row<type, 32, fallback>(ctx, args, stream);
+            break;
+        default:
+            fprintf(stderr, "few_row J_best=%d\n", J_best);
+            GGML_ABORT("fatal error");
+            break;
+    }
+}
