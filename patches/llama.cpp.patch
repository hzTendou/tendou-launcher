+extern "C" {
+
+GGML_BACKEND_API bool ggml_backend_cuda_fattn_uses_vec_for_shape(
+        int device, int head_dim, int n_kv, int gqa_ratio, int n_q,
+        enum ggml_type type_k, enum ggml_type type_v) {
+#ifndef FLASH_ATTN_AVAILABLE
+    GGML_UNUSED_VARS(device, head_dim, n_kv, gqa_ratio, n_q, type_k, type_v);
+    return false;
+#else
+    const ggml_cuda_device_info & info = ggml_cuda_info();
+    if (device < 0 || device >= info.device_count || device >= GGML_CUDA_MAX_DEVICES) {
+        return false;
+    }
+    if (head_dim <= 0 || n_kv <= 0 || gqa_ratio <= 0 || n_q <= 0) {
+        return false;
+    }
+    if ((int) type_k < 0 || type_k >= GGML_TYPE_COUNT ||
+        (int) type_v < 0 || type_v >= GGML_TYPE_COUNT) {
+        return false;
+    }
+    if (head_dim % ggml_blck_size(type_k) != 0 || head_dim % ggml_blck_size(type_v) != 0) {
+        return false;
+    }
+
+    ggml_tensor Q{};
+    Q.type  = GGML_TYPE_F32;
+    Q.ne[0] = head_dim;
+    Q.ne[1] = n_q;
+    Q.ne[2] = gqa_ratio;
+    Q.ne[3] = 1;
+    Q.nb[0] = ggml_type_size(Q.type);
+    Q.nb[1] = ggml_row_size(Q.type, Q.ne[0]);
+    Q.nb[2] = Q.nb[1] * Q.ne[1];
+    Q.nb[3] = Q.nb[2] * Q.ne[2];
+
+    ggml_tensor K{};
+    K.type  = type_k;
+    K.ne[0] = head_dim;
+    K.ne[1] = n_kv;
+    K.ne[2] = 1;
+    K.ne[3] = 1;
+    K.nb[0] = ggml_type_size(K.type);
+    K.nb[1] = ggml_row_size(K.type, K.ne[0]);
+    K.nb[2] = K.nb[1] * K.ne[1];
+    K.nb[3] = K.nb[2] * K.ne[2];
+
+    ggml_tensor V{};
+    V.type  = type_v;
+    V.ne[0] = head_dim;
+    V.ne[1] = n_kv;
+    V.ne[2] = 1;
+    V.ne[3] = 1;
+    V.nb[0] = ggml_type_size(V.type);
+    V.nb[1] = ggml_row_size(V.type, V.ne[0]);
+    V.nb[2] = V.nb[1] * V.ne[1];
+    V.nb[3] = V.nb[2] * V.ne[2];
+
+    ggml_tensor mask{};
+    mask.type  = GGML_TYPE_F16;
+    mask.ne[0] = n_kv;
+    mask.ne[1] = n_q;
+    mask.ne[2] = 1;
+    mask.ne[3] = 1;
+    mask.nb[0] = ggml_type_size(mask.type);
+    mask.nb[1] = ggml_row_size(mask.type, mask.ne[0]);
+    mask.nb[2] = mask.nb[1] * mask.ne[1];
+    mask.nb[3] = mask.nb[2] * mask.ne[2];
+
+    ggml_tensor dst{};
+    dst.op     = GGML_OP_FLASH_ATTN_EXT;
+    dst.type   = GGML_TYPE_F32;
+    dst.ne[0]  = head_dim;
+    dst.ne[1]  = gqa_ratio;
+    dst.ne[2]  = n_q;
+    dst.ne[3]  = 1;
+    dst.nb[0]  = ggml_type_size(dst.type);
+    dst.nb[1]  = ggml_row_size(dst.type, dst.ne[0]);
+    dst.nb[2]  = dst.nb[1] * dst.ne[1];
+    dst.nb[3]  = dst.nb[2] * dst.ne[2];
+    dst.src[0] = &Q;
+    dst.src[1] = &K;
+    dst.src[2] = &V;
+    dst.src[3] = &mask;
+
+    return ggml_cuda_get_best_fattn_kernel(device, &dst) == BEST_FATTN_KERNEL_VEC;
+#endif // FLASH_ATTN_AVAILABLE
+}
