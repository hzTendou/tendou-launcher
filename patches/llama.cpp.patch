+#include <cstdlib>
+
+static void atlas_hc_mix_cpu_cb(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) userdata;
+    const int64_t n_embd = dst->op_params[8];
+    const int64_t hc     = dst->op_params[9];
+    const int64_t nt     = dst->op_params[10];
+    const bool apply_sig = dst->op_params[11] != 0;
+    const float * xn     = (const float *) dst->src[0]->data;
+    const float * gate   = (const float *) dst->src[1]->data;
+    float * out          = (float *) dst->data;
+    const int64_t total  = n_embd * nt;
+    const int64_t chunk  = (total + nth - 1) / std::max(1, nth);
+    const int64_t beg    = std::min(total, (int64_t) ith * chunk);
+    const int64_t end    = std::min(total, beg + chunk);
+    const float inv_hc   = 1.0f / (float) hc;
+    for (int64_t idx = beg; idx < end; ++idx) {
+        const int64_t t = idx / n_embd;
+        const int64_t e = idx % n_embd;
+        float sum = 0.0f;
+        const float * xcol = xn + t * hc * n_embd + e;
+        const float * gcol = gate + t * hc * n_embd + e;
+        for (int64_t c = 0; c < hc; ++c) {
+            float g = gcol[c * n_embd];
+            if (apply_sig) g = 1.0f / (1.0f + std::exp(-g));
+            sum += xcol[c * n_embd] * g;
+        }
+        out[idx] = sum * inv_hc;
+    }
+}
+
+static void atlas_hc_comb_cpu_cb(struct ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) userdata;
+    const int64_t n_embd = dst->op_params[8];
+    const int64_t hc     = dst->op_params[9];
+    const int64_t nt     = dst->op_params[10];
+    const float * res    = (const float *) dst->src[0]->data;
+    const float * bout   = (const float *) dst->src[1]->data;
+    const float * inj    = (const float *) dst->src[2]->data;
+    float * out          = (float *) dst->data;
+    const int64_t total  = n_embd * hc * nt;
+    const int64_t chunk  = (total + nth - 1) / std::max(1, nth);
+    const int64_t beg    = std::min(total, (int64_t) ith * chunk);
+    const int64_t end    = std::min(total, beg + chunk);
+    const float inv_hc   = 1.0f / (float) hc;
+    for (int64_t idx = beg; idx < end; ++idx) {
+        const int64_t t   = idx / (hc * n_embd);
+        const int64_t rem = idx % (hc * n_embd);
+        const int64_t c   = rem / n_embd;
+        const int64_t e   = rem % n_embd;
+        const float w     = 2.0f / (1.0f + std::exp(-inj[t * hc + c] * inv_hc));
+        out[idx] = res[idx] + bout[t * n_embd + e] * w;
+    }
+}
+
+static bool atlas_use_hc_fusion() {
+    static const bool enabled = []() {
+        const char * env = std::getenv("ATLAS_HC_FUSION");
+        return env ? (std::atoi(env) != 0) : true;
+    }();
+    return enabled;
+}
 
