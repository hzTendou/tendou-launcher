+template <ggml_type type>
+void mul_mat_q_few_row_case(ggml_backend_cuda_context & ctx, const mmq_few_row_args & args, cudaStream_t stream) {
+    if (args.nrows_x % 128 == 0) {
+        constexpr bool fallback = false;
+        mul_mat_q_few_row_switch_J<type, fallback>(ctx, args, stream);
+    } else {
+        constexpr bool fallback = true;
+        mul_mat_q_few_row_switch_J<type, fallback>(ctx, args, stream);
+    }
+}
