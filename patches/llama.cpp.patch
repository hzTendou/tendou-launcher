+#if defined(FP8_AVAILABLE) && !defined(GGML_USE_HIP)
+typedef __nv_fp8_e4m3   ggml_cuda_fp8_e4m3_t;
+typedef __nv_fp8x2_e4m3 ggml_cuda_fp8x2_e4m3_t;
+typedef __nv_fp8x4_e4m3 ggml_cuda_fp8x4_e4m3_t;
+#else
+struct ggml_cuda_fp8_e4m3_t {
+    uint8_t __x;
+};
+struct __align__(2) ggml_cuda_fp8x2_e4m3_t {
+    uint16_t __x;
+};
+struct __align__(4) ggml_cuda_fp8x4_e4m3_t {
+    uint32_t __x;
+};
+
+static __host__ __device__ inline float ggml_cuda_fp8_e4m3_bits_to_fp32(uint8_t x) {
+    const uint32_t sign = ((uint32_t) (x & 0x80u)) << 24;
+    const uint32_t ax   = (uint32_t) (x & 0x7Fu);
+    uint32_t bits;
+
+    if (ax == 0x7Fu) {
+        bits = sign | 0x7FC00000u;
+    } else if (ax == 0u) {
+        bits = sign;
+    } else {
+        uint32_t exp = ax >> 3;
+        uint32_t man = ax & 0x7u;
+        if (exp == 0u) {
+            uint32_t fp32_exp = 121u;
+            while ((man & 0x8u) == 0u) {
+                man <<= 1;
+                fp32_exp--;
+            }
+            man &= 0x7u;
+            bits = sign | (fp32_exp << 23) | (man << 20);
+        } else {
+            uint32_t fp32_exp = exp + 120u;
+            bits = sign | (fp32_exp << 23) | (man << 20);
+        }
+    }
+
+    float result;
+    memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+static __host__ __device__ inline uint8_t ggml_cuda_fp32_to_fp8_e4m3_bits(float x) {
+    uint32_t bits;
+    memcpy(&bits, &x, sizeof(bits));
+
+    const uint8_t  sign = (uint8_t) ((bits >> 24) & 0x80u);
+    const uint32_t absx = bits & 0x7FFFFFFFu;
+
+    if (absx > 0x7F800000u) {
+        return (uint8_t) (sign | 0x7Fu);
+    }
+    if (absx <= 0x3A800000u) {
+        return sign;
+    }
+    if (absx >= 0x43E00000u) {
+        return (uint8_t) (sign | 0x7Eu);
+    }
+    if (absx >= 0x3C800000u) {
+        const uint32_t fp8_exp   = ((absx >> 23) & 0xFFu) - 120u;
+        const uint32_t fp8_man   = (absx >> 20) & 0x7u;
+        const uint32_t round_rem = absx & 0xFFFFFu;
+        uint32_t res = (fp8_exp << 3) | fp8_man;
