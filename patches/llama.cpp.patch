+                vdot(ncols, &out[r], 0, (const char *) bx + (size_t) r * row_x_sz, 0, by, 0, 1);
+            }
+        }
+    }
+    const int64_t dt_us = ggml_time_us() - t0;
+    free(bx);
+    free(by);
+    free(out);
+    if (dt_us <= 0) return 0.0;
+    const double bytes_total = (double) n_iters * (double) n_rows * (double) row_x_sz;
+    return (bytes_total / (1024.0 * 1024.0 * 1024.0)) / ((double) dt_us * 1e-6);
+}
+
