+static inline void ggml_cpu_update_adaptive_k_from_graph(const struct ggml_cgraph * cgraph) {
+    if (!cgraph) return;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        struct ggml_tensor * node = cgraph->nodes[i];
+        if (!node) continue;
+        for (int s = -1; s < GGML_MAX_SRC; ++s) {
+            const struct ggml_tensor * t = (s == -1) ? node : node->src[s];
+            if (!t || !t->name[0] || !t->data) continue;
+            if (t->name[0] != 'f' || t->name[4] != 'm') continue;
+            static const char * p_norm = "ffn_moe_weights_norm-";
+            static const char * p_scaled = "ffn_moe_weights_scaled-";
+            int layer = -1;
+            if (strncmp(t->name, p_norm, 21) == 0) {
+                layer = atoi(t->name + 21);
+            } else if (strncmp(t->name, p_scaled, 23) == 0) {
+                layer = atoi(t->name + 23);
+            }
+            if (layer >= 15 && layer <= 30 && t->ne[2] == 1 && (t->ne[0] > 1 || t->ne[1] > 1)) { // Single-token decode
+                const int count = (int)(t->ne[0] > 1 ? t->ne[0] : t->ne[1]);
+                const float * w = (const float *)t->data;
+                const size_t stride = (t->ne[0] > 1) ? sizeof(float) : t->nb[1];
+                if (count > 0 && w) {
+                    float max1 = -1e9f;
+                    float max2 = -1e9f;
+                    for (int idx = 0; idx < count; ++idx) {
+                        float val = *(const float *)((const char *)w + idx * stride);
+                        if (val > max1) {
+                            max2 = max1;
+                            max1 = val;
+                        } else if (val > max2) {
+                            max2 = val;
+                        }
+                    }
+                    float w_0 = (max1 > -1e8f) ? max1 : 1.0f;
+                    float w_1 = (max2 > -1e8f) ? max2 : 0.0f;
+                    float margin = w_0 - w_1;
+
+                    // Calibrated router-confidence adaptive Entropy-K gating:
+                    static float s_entropy_w0 = -1.0f;
+                    static float s_entropy_margin = -1.0f;
+                    if (s_entropy_w0 < 0.0f) {
+                        const char * env_w0 = getenv("ATLAS_ENTROPY_W0");
+                        s_entropy_w0 = env_w0 ? (float)atof(env_w0) : 0.40f;
+                        const char * env_m = getenv("ATLAS_ENTROPY_MARGIN");
+                        s_entropy_margin = env_m ? (float)atof(env_m) : 0.15f;
+                    }
+                    int keep_k = (w_0 < s_entropy_w0 || margin < s_entropy_margin) ? 4 : 2;
+                    extern int g_atlas_layer_adaptive_k[48];
