+bool llama_model_alias_embeddings(struct llama_model * model_dft, const struct llama_model * model_tgt) {
+    if (!model_dft || !model_tgt) {
+        return false;
+    }
+    std::fprintf(stderr, "[DEBUG-ALIAS] model_tgt->tok_embd=%p, buffer=%p, buft=%s\n",
+        (void*)model_tgt->tok_embd,
+        model_tgt->tok_embd ? (void*)model_tgt->tok_embd->buffer : nullptr,
+        (model_tgt->tok_embd && model_tgt->tok_embd->buffer) ? ggml_backend_buft_name(ggml_backend_buffer_get_type(model_tgt->tok_embd->buffer)) : "null");
+    std::fprintf(stderr, "[DEBUG-ALIAS] model_tgt->output=%p, buffer=%p, buft=%s\n",
+        (void*)model_tgt->output,
+        model_tgt->output ? (void*)model_tgt->output->buffer : nullptr,
+        (model_tgt->output && model_tgt->output->buffer) ? ggml_backend_buft_name(ggml_backend_buffer_get_type(model_tgt->output->buffer)) : "null");
+    std::fprintf(stderr, "[DEBUG-ALIAS] model_dft->output=%p, buffer=%p, buft=%s\n",
+        (void*)model_dft->output,
+        model_dft->output ? (void*)model_dft->output->buffer : nullptr,
+        (model_dft->output && model_dft->output->buffer) ? ggml_backend_buft_name(ggml_backend_buffer_get_type(model_dft->output->buffer)) : "null");
+    std::fprintf(stderr, "[DEBUG-ALIAS] model_tgt->output_norm=%p, hc_head_norm=%p\n",
+        (void*)model_tgt->output_norm, (void*)model_tgt->hc_head_norm);
+    if (model_tgt->tok_embd) {
+        model_dft->tok_embd = model_tgt->tok_embd;
+    }
+    if (model_tgt->output) {
+        model_dft->output = model_tgt->output;
+    }
+    if (model_tgt->output_s) {
+        model_dft->output_s = model_tgt->output_s;
+    }
+    if (model_tgt->output_in_s) {
+        model_dft->output_in_s = model_tgt->output_in_s;
+    }
+    if (model_tgt->output_norm) {
+        model_dft->output_norm = model_tgt->output_norm;
+    }
+    if (model_tgt->hc_head_norm) {
+        model_dft->hc_head_norm = model_tgt->hc_head_norm;
+    }
+    if (model_tgt->hc_head_down) {
+        model_dft->hc_head_down = model_tgt->hc_head_down;
+    }
+    if (model_tgt->hc_head_up) {
+        model_dft->hc_head_up = model_tgt->hc_head_up;
+    }
+    LLAMA_LOG_INFO("[ATLAS-MTP] Zero-copy embedding & head aliased from target model (tok_embd=%p, output=%p)\n",
+        (void*)model_dft->tok_embd, (void*)model_dft->output);
+    return true;
+}
+
