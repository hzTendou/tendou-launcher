+                if (freq_map_[key] >= admission_threshold_) {
+                    if (buffer_.can_fit()) {
+                        buffer_.bind_expert(layer, exp);
+                    } else if (buffer_.get_capacity_bytes() > 0) {
+                        ExpertKey victim{};
+                        if (evict_lowest_frequency(current_set, freq_map_[key], victim)) {
+                            buffer_.bind_expert(layer, exp);
+                        }
+                    }
+                }
+            }
+        }
+        return res;
+    }
+
+    bool evict_lowest_frequency(const std::unordered_set<ExpertKey, KeyHash> & keep_set, uint32_t candidate_freq, ExpertKey & evicted) {
+        const auto & residents = buffer_.get_lru_order();
+        if (residents.empty()) return false;
+
+        uint32_t min_freq = UINT32_MAX;
+        ExpertKey best_victim{};
+        bool found = false;
+
+        // Iterate LRU order from oldest to newest: the first entry found with minimal frequency
+        // is guaranteed to be the least recently used victim among frequency ties.
+        for (const auto & key : residents) {
+            if (keep_set.find(key) != keep_set.end()) continue;
+            auto it = freq_map_.find(key);
+            uint32_t f = (it != freq_map_.end()) ? it->second : 0;
+            if (f < min_freq) {
+                min_freq = f;
+                best_victim = key;
+                found = true;
+                if (f <= 1) {
+                    // Cannot get lower than 1 for an active resident; first in LRU order is optimal victim
+                    break;
+                }
+            }
+        }
+
+        // FLE admission: if candidate active frequency meets or exceeds victim's minimal frequency,
+        // promote the candidate and evict the stale resident victim.
+        if (found && candidate_freq >= min_freq) {
+            evicted = best_victim;
+            return buffer_.evict_expert(best_victim);
+        }
+        return false;
+    }
+
+    uint64_t get_hits() const { return cache_hits_; }
+    uint64_t get_misses() const { return cache_misses_; }
+    double get_hit_rate() const {
+        uint64_t total = cache_hits_ + cache_misses_;
+        return total > 0 ? (double)cache_hits_ / (double)total : 0.0;
+    }
+    double get_expert_wait_us() const { return 0.0; } // Zero-stall guarantee
+
+    void reset_stats() {
+        cache_hits_ = 0;
+        cache_misses_ = 0;
+        // Age the frequency map across prompt/request boundaries:
+        // Decay resident frequencies by half and drop unreferenced non-resident counts
+        // so new tasks can establish their own active working sets without cache starvation.
+        std::unordered_map<ExpertKey, uint32_t, KeyHash> decayed;
+        for (const auto & key : buffer_.get_resident_experts()) {
+            auto it = freq_map_.find(key);
+            decayed[key] = (it != freq_map_.end()) ? std::max(1u, it->second / 2) : 1u;
+        }
+        freq_map_ = std::move(decayed);
+    }
+
+private:
+    GPUExpertBuffer & buffer_;
+    uint32_t admission_threshold_;
+    std::unordered_map<ExpertKey, uint32_t, KeyHash> freq_map_;
+    uint64_t cache_hits_ = 0;
+    uint64_t cache_misses_ = 0;
+};
